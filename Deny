SELECT
    annee,
    canal_acquisition,
    nb_commandes,
    total_annee,
    ROUND(
        100.0 * nb_commandes / total_annee,
        2
    ) AS pct_total

FROM
(
    SELECT
        YEAR(`date-de-saisie-commande`) AS annee,
        `canal-acquisition` AS canal_acquisition,
        COUNT(DISTINCT `identifiant-commande`) AS nb_commandes,

        SUM(
            COUNT(DISTINCT `identifiant-commande`)
        ) OVER (
            PARTITION BY YEAR(`date-de-saisie-commande`)
        ) AS total_annee

    FROM commande_carnet_chezki

    WHERE YEAR(`date-de-saisie-commande`) IN (2024, 2025, 2026)

    GROUP BY
        YEAR(`date-de-saisie-commande`),
        `canal-acquisition`
) t

UNION ALL

SELECT
    YEAR(`date-de-saisie-commande`) AS annee,
    'TOTAL' AS canal_acquisition,
    COUNT(DISTINCT `identifiant-commande`) AS nb_commandes,
    COUNT(DISTINCT `identifiant-commande`) AS total_annee,
    100.00 AS pct_total

FROM commande_carnet_chezki

WHERE YEAR(`date-de-saisie-commande`) IN (2024, 2025, 2026)

GROUP BY
    YEAR(`date-de-saisie-commande`)

ORDER BY
    annee,
    canal_acquisition;

SELECT
    annee,
    canal_acquisition,
    nb_commandes,
    ROUND(
        100.0 * nb_commandes / total_annee,
        2
    ) AS pct_total
FROM
(
    SELECT
        annee,
        canal_acquisition,
        nb_commandes,
        total_annee

    FROM
    (
        /* Nombre de commandes par année et par canal */
        SELECT
            YEAR(date_saisie) AS annee,
            canal_acquisition,
            COUNT(DISTINCT id_commande) AS nb_commandes

        FROM commande_carnet_chezki

        WHERE YEAR(date_saisie) IN (2024, 2025, 2026)

        GROUP BY
            YEAR(date_saisie),
            canal_acquisition
    ) commandes_canal

    LEFT JOIN
    (
        /* Nombre total de commandes par année */
        SELECT
            YEAR(date_saisie) AS annee,
            COUNT(DISTINCT id_commande) AS total_annee

        FROM commande_carnet_chezki

        WHERE YEAR(date_saisie) IN (2024, 2025, 2026)

        GROUP BY
            YEAR(date_saisie)
    ) commandes_total

    ON commandes_canal.annee = commandes_total.annee
) detail

UNION ALL

/* Ligne TOTAL par année */
SELECT
    YEAR(date_saisie) AS annee,
    'TOTAL' AS canal_acquisition,
    COUNT(DISTINCT id_commande) AS nb_commandes,
    100.00 AS pct_total

FROM commande_carnet_chezki

WHERE YEAR(date_saisie) IN (2024, 2025, 2026)

GROUP BY
    YEAR(date_saisie)

ORDER BY
    annee,
    CASE
        WHEN canal_acquisition = 'TOTAL' THEN 2
        ELSE 1
    END,
    nb_commandes DESC;

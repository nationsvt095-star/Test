SELECT
    annee,
    canal_acquisition,
    niveau,
    motif_rejet,
    nb_commandes,

    ROUND(
        100.0 * nb_commandes
        / SUM(
            CASE
                WHEN niveau = 'TOTAL'
                THEN nb_commandes
                ELSE 0
            END
          ) OVER (
              PARTITION BY annee, canal_acquisition
          ),
        2
    ) AS pourcentage_total

FROM
(
    /* =========================================================
       1. TOTAL
       ========================================================= */
    SELECT
        YEAR(date_saisie) AS annee,
        canal_acquisition,
        'TOTAL' AS niveau,
        NULL AS motif_rejet,
        COUNT(DISTINCT id_commande) AS nb_commandes

    FROM commande_carnet_chezki

    WHERE YEAR(date_saisie) IN (2024, 2025, 2026)

    GROUP BY
        YEAR(date_saisie),
        canal_acquisition


    UNION ALL


    /* =========================================================
       2. REJET / NON-REJET
       ========================================================= */
    SELECT
        YEAR(date_saisie) AS annee,
        canal_acquisition,

        CASE
            WHEN motif_rejet IS NULL
              OR TRIM(motif_rejet) = ''
            THEN 'NON-REJET'
            ELSE 'REJET'
        END AS niveau,

        NULL AS motif_rejet,

        COUNT(DISTINCT id_commande) AS nb_commandes

    FROM commande_carnet_chezki

    WHERE YEAR(date_saisie) IN (2024, 2025, 2026)

    GROUP BY
        YEAR(date_saisie),
        canal_acquisition,

        CASE
            WHEN motif_rejet IS NULL
              OR TRIM(motif_rejet) = ''
            THEN 'NON-REJET'
            ELSE 'REJET'
        END


    UNION ALL


    /* =========================================================
       3. DETAIL DES MOTIFS DE REJET
       ========================================================= */
    SELECT
        YEAR(date_saisie) AS annee,
        canal_acquisition,

        'REJET' AS niveau,

        motif_rejet,

        COUNT(DISTINCT id_commande) AS nb_commandes

    FROM commande_carnet_chezki

    WHERE YEAR(date_saisie) IN (2024, 2025, 2026)

      AND motif_rejet IS NOT NULL
      AND TRIM(motif_rejet) <> ''

    GROUP BY
        YEAR(date_saisie),
        canal_acquisition,
        motif_rejet

) synthese

ORDER BY
    annee,
    canal_acquisition,
    CASE
        WHEN niveau = 'TOTAL' THEN 1
        WHEN niveau = 'NON-REJET' THEN 2
        WHEN niveau = 'REJET' AND motif_rejet IS NULL THEN 3
        ELSE 4
    END,
    nb_commandes DESC;




